---
const enabled = import.meta.env.PUBLIC_SIGNUP_ENABLED === "true";
---
<section id="powiadomienie" class="signup" aria-labelledby="signup-title"><div class="signup-copy"><span class="eyebrow">DO ZOBACZENIA NA SZLAKU</span><h2 id="signup-title">Nie przegap zapisów.</h2><p>Zostaw e-mail. Damy Ci znać, gdy ruszą zapisy na Nowy Żmigród Dragon Trail.</p></div><form id="signup-form" hidden={!enabled}><label for="email">Twój e-mail</label><div class="signup-row"><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="ty@example.com"/><button type="submit">Powiadom mnie <span aria-hidden="true">→</span></button></div><div class="hp" aria-hidden="true"><label>Strona internetowa<input name="website" type="text" tabindex="-1" autocomplete="off"/></label></div><label class="consent"><input name="consent" type="checkbox" required/><span>Chcę otrzymać jeden e-mail o uruchomieniu zapisów na Nowy Żmigród Dragon Trail 2027. <a href="/prywatnosc/">Informacja o prywatności</a>.</span></label><p class="signup-hint">Administratorem danych jest Lucjan Suski, <a href="mailto:lucjan@dragontrail.pl">lucjan@dragontrail.pl</a>.</p><p class="signup-hint">Wyślemy link potwierdzający. Zapis będzie aktywny dopiero po potwierdzeniu adresu.</p><p id="signup-status" role="status" aria-live="polite"></p></form>{!enabled && <p class="signup-paused">Powiadomienia uruchomimy wkrótce. Wróć tutaj, aby zostawić swój adres.</p>}</section>
<script>
const form=document.querySelector<HTMLFormElement>('#signup-form');form?.addEventListener('submit',async e=>{e.preventDefault();if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('button')!,status=document.querySelector<HTMLElement>('#signup-status')!;button.disabled=true;status.textContent='Wysyłanie…';const data=new FormData(form);try{const response=await fetch('/api/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:data.get('email'),consent:data.get('consent')==='on',website:data.get('website')||''})});if(!response.ok)throw Error('request');status.textContent='Sprawdź skrzynkę i kliknij link potwierdzający. Jeśli wiadomości nie ma, zajrzyj też do spamu.';form.reset();}catch{status.textContent='Nie udało się wysłać zgłoszenia. Spróbuj ponownie za chwilę.';}finally{button.disabled=false;}});
</script>
<style>.signup{background:#f5f1e4;color:#173e30;padding:clamp(38px,7vw,90px);display:grid;grid-template-columns:1fr 1fr;gap:50px;scroll-margin-top:30px}.signup h2{font-family:Georgia,serif;font-size:clamp(34px,4vw,56px);line-height:1.08;margin:15px 0}.signup p{line-height:1.6;max-width:42ch}.signup label{font-weight:650;display:block;margin-bottom:10px}.signup-row{display:flex;gap:10px}.signup input[type=email]{width:100%;min-width:0;background:#fff;border:1px solid #9ba99a;border-radius:5px;padding:16px;font:inherit}.signup button{border:0;border-radius:5px;background:#1a4c37;color:#fff;padding:15px 22px;font:inherit;font-weight:700;white-space:nowrap;cursor:pointer}.signup button:disabled{opacity:.6;cursor:wait}.signup .consent{display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:400;line-height:1.5;margin-top:20px}.consent input{margin-top:4px;accent-color:#1a4c37}.signup a{color:inherit}.signup-hint{font-size:13px;color:#4c6255}.hp{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}#signup-status{font-weight:600;font-size:15px;min-height:1.5em}.signup input:focus-visible,.signup button:focus-visible{outline:3px solid #cf764a;outline-offset:3px}@media(max-width:800px){.signup{grid-template-columns:1fr;gap:20px;padding:40px 22px}.signup-row{flex-direction:column}.signup button{width:100%}}</style>
