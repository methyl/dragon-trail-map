---
const {title,description,action,label}=Astro.props;
---
<!doctype html><html lang="pl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><meta name="referrer" content="no-referrer"/><title>{title} · Dragon Trail</title></head><body><main><a href="/">Nowy Żmigród Dragon Trail</a><h1>{title}</h1><p>{description}</p><form id="action-form" data-action={action}><button type="submit">{label}</button></form><p id="action-status" role="status" aria-live="polite"></p></main><script>
const form=document.querySelector<HTMLFormElement>('#action-form'),status=document.querySelector<HTMLElement>('#action-status');const token=new URLSearchParams(location.search).get('token');if(!token&&status&&form){status.textContent='Brakuje poprawnego linku. Otwórz pełny link z wiadomości e-mail.';form.hidden=true;}form?.addEventListener('submit',async e=>{e.preventDefault();const b=form.querySelector<HTMLButtonElement>('button')!;b.disabled=true;status!.textContent='Chwileczkę…';try{const response=await fetch('/api/'+form.dataset.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token})});if(!response.ok)throw Error('invalid');status!.textContent=form.dataset.action==='confirm'?'Adres potwierdzony. Powiadomimy Cię, gdy ruszą zapisy.':'Zapis został anulowany. Nie wyślemy powiadomienia.';form.hidden=true;history.replaceState(null,'',location.pathname);}catch{status!.textContent='Nie udało się obsłużyć linku. Mógł wygasnąć lub zostać użyty. Spróbuj ponownie albo wróć na stronę główną.';b.disabled=false;}});
</script><style is:global>body{margin:0;background:#123c2f;color:#faf5e7;font:18px/1.6 system-ui,sans-serif}main{max-width:620px;margin:12vh auto;padding:30px}a{color:inherit}h1{font-family:Georgia,serif;font-size:clamp(32px,6vw,48px);line-height:1.15}button{background:#ce7549;color:#fff;border:0;border-radius:5px;padding:16px 24px;font:inherit;cursor:pointer}button:disabled{opacity:.5}button:focus-visible,a:focus-visible{outline:3px solid #fff;outline-offset:5px}#action-status{min-height:3em}</style></body></html>
